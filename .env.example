# PayPal sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional. Defaults to the sandbox API.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# AI: the agent calls models through the Vercel AI Gateway.
# On Vercel this authenticates automatically (OIDC). Locally, set a gateway key.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-4o-mini
