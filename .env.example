# PayPal sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional. Defaults to the sandbox API.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# AI: Gemini API key from aistudio.google.com (free tier works)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional comma-separated fallback list
AI_MODELS=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.8-flash
